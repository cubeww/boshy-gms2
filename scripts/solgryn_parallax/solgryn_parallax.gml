function solgryn_draw_parallax(_sprite, _rows, _x, _y, _scroll, _width, _divisor = 150, _alpha = 1) {
    for (var _row = 0; _row < array_length(_rows); ++_row) {
        var _span = _rows[_row];
        var _source_x = _span[0];
        var _span_width = _span[1];
        if (_span_width == 0) {
            continue;
        }

        var _offset = ((_width - _span_width) div 2) + floor(-_scroll * _span_width / _divisor);
        var _dest_x = _offset - ceil(_offset / _span_width) * _span_width;
        while (_dest_x < _width) {
            var _clip_left = max(0, -_dest_x);
            var _clip_right = min(_span_width, _width - _dest_x);
            draw_sprite_part_ext(_sprite, 0, _source_x + _clip_left, _row, _clip_right - _clip_left, 1,
                _x + _dest_x + _clip_left, _y + _row, 1, 1, c_white, _alpha);
            _dest_x += _span_width;
        }
    }
}
